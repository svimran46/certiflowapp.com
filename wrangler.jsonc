{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets are built from public/ into dist/ by `npm run build`.
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds deploys to it).
  "name": "certiflowapp-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Build public/ into dist/ on every deploy and dev run, whatever the
  // dashboard's build command is set to.
  "build": { "command": "node scripts/build.mjs", "watch_dir": "public" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // With a 404 page set, the asset layer answers every GET it can't match
    // and the Worker never runs. Send the Worker's own routes to it first.
    "run_worker_first": ["/auth/*", "/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "certiflow-leads",
      "database_id": "4f1ed89e-21ba-4a96-80a8-841c284c05ae",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
