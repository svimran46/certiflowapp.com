{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets are built from public/ into dist/ by `npm run build`.
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds deploys to it).
  "name": "certiflowapp-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Build public/ into dist/ on every deploy and dev run, whatever the
  // dashboard's build command is set to.
  "build": { "command": "node scripts/build.mjs", "watch_dir": "public" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // DIAGNOSTIC (temporary): D1 binding removed to test whether Workers Builds fails on D1 permissions.
  "observability": { "enabled": true }
}
